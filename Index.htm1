<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Archita Remix</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b0b0f;
      color: white;
      text-align: center;
    }

    header {
      padding: 45px 20px;
      background: linear-gradient(135deg, #18002b, #090014);
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .tagline {
      color: #ccc;
      font-size: 17px;
    }

    .btn {
      display: inline-block;
      margin-top: 25px;
      padding: 14px 28px;
      background: #ff1744;
      color: white;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
    }

    section {
      padding: 35px 20px;
    }

    h2 {
      margin-bottom: 20px;
      font-size: 28px;
    }

    .cards {
      display: grid;
      gap: 15px;
      max-width: 600px;
      margin: auto;
    }

    .card {
      padding: 20px;
      background: #17171f;
      border-radius: 15px;
      border: 1px solid #292936;
    }

    .card h3 {
      margin-bottom: 8px;
    }

    footer {
      padding: 25px;
      background: #050507;
      color: #aaa;
    }
  </style>
</head>

<body>

  <header>
    <h1>🎧 ARCHITA REMIX</h1>
    <p class="tagline">DJ Remix • Bass Boosted • Viral Mashups</p>

    <a class="btn" href="https://youtube.com/@archita_remix" target="_blank">
      ▶️ SUBSCRIBE ON YOUTUBE
    </a>
  </header>

  <section>
    <h2>🔥 Remix Categories</h2>

    <div class="cards">
      <div class="card">
        <h3>🎵 Odia Remix</h3>
        <p>Latest Odia DJ Remix Songs</p>
      </div>

      <div class="card">
        <h3>🎧 Hindi Remix</h3>
        <p>Trending Hindi Remix & Mashups</p>
      </div>

      <div class="card">
        <h3>🔊 Bass Boosted</h3>
        <p>Powerful Bass & DJ Mixes</p>
      </div>

      <div class="card">
        <h3>🔥 Viral Mashups</h3>
        <p>Trending DJ Mashup Songs</p>
      </div>
    </div>
  </section>

  <section>
    <h2>📱 Follow Archita Remix</h2>
    <p>More Remix Songs & Updates Coming Soon!</p>

    <a class="btn" href="https://youtube.com/@archita_remix" target="_blank">
      YouTube
    </a>
  </section>

  <footer>
    © 2026 Archita Remix • All Rights Reserved
  </footer>

</body>
</html>
